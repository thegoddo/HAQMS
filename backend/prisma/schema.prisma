generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOCTOR
  RECEPTIONIST
}

enum AppointmentStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum QueueStatus {
  WAITING
  CALLING
  COMPLETED
  SKIPPED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(RECEPTIONIST)
  createdAt DateTime @default(now())

  doctor Doctor?
}

model Doctor {
  id              String   @id @default(uuid())
  userId          String?  @unique
  user            User?    @relation(fields: [userId], references: [id])
  name            String
  specialization  String
  department      String
  consultationFee Float
  experience      Int
  availableFrom   String   @default("09:00")
  availableTo     String   @default("17:00")
  createdAt       DateTime @default(now())

  appointments Appointment[]
  queueTokens  QueueToken[]

  // FIX: Added indexes on department and specialization to prevent full table scans at scale.
  @@index([department])
  @@index([specialization])
}

model Patient {
  id             String   @id @default(uuid())
  name           String
  email          String?
  phoneNumber    String
  age            Int
  gender         String
  medicalHistory String?  // Remember to use optional chaining (?.) on the frontend!
  createdAt      DateTime @default(now())

  appointments Appointment[]
  queueTokens  QueueToken[]
}

model Appointment {
  id              String            @id @default(uuid())
  patientId       String
  patient         Patient           @relation(fields: [patientId], references: [id])
  doctorId        String
  doctor          Doctor            @relation(fields: [doctorId], references: [id])
  appointmentDate DateTime
  reason          String            @default("")
  status          AppointmentStatus @default(PENDING)
  createdAt       DateTime          @default(now())

  queueTokens QueueToken[]

  // FIX: Hard constraint preventing double-booking the same physician at the exact same time slot.
  @@unique([doctorId, appointmentDate])
  
  // FIX: Added index on patientId for faster foreign key relational joins.
  @@index([patientId])
  
  // FIX: Added composite index on (doctorId, status) to optimize clinician worklist dashboard queries.
  @@index([doctorId, status])
}

model QueueToken {
  id            String      @id @default(uuid())
  tokenNumber   Int
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id])
  doctorId      String
  doctor        Doctor      @relation(fields: [doctorId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  status        QueueStatus @default(WAITING)
  createdAt     DateTime    @default(now())

  // FIX: Added composite index on doctorId and createdAt for lightning-fast daily token rollups.
  @@index([doctorId, createdAt])
  
  // FIX: Added index on status since queue status filtering happens constantly.
  @@index([status])
}

model QueueCounter {
  id        String   @id @default(uuid())
  doctorId  String
  dateStr   String   // e.g., "2026-05-28"
  lastToken Int      @default(0)

  @@unique([doctorId, dateStr]) // Ensures one atomic sequence counter per doctor per day
}